[mysqld]
# 连接数（配合 MaxOpenConns=100）
max_connections = 200

# InnoDB buffer pool（建议设为物理内存的 60-70%）
innodb_buffer_pool_size = 4G

# 连接超时（比 ConnMaxLifetime=1h 稍长）
wait_timeout = 7200
interactive_timeout = 7200

# 连接数限制（防止突发尖峰撑爆连接）
max_connect_errors = 10000

# 慢查询日志（用来发现管理面的慢 SQL）
slow_query_log = 1
long_query_time = 1

